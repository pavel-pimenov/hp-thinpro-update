# Документация по переменным — при необходимости скопируйте в .env
#
# Куда класть данные (каталоги, индекс, зеркало)
DATA_DIR=/data
# Директория для «точечной» выгрузки файлов на сервер (зеркало).
# Пустая строка = только проксирование, без сохранения на диск.
CACHE_DIR=/data/mirror

# Базовый адрес HP FTP (http или https).
UPSTREAM_BASE=https://ftp.hp.com

# Интервал фонового обновления каталогов, часы.
REFRESH_INTERVAL_HOURS=12

# Секрет для flash-сообщений/сессий.
SECRET_KEY=change-me-before-prod

# Сколько файлов качать на сервер одновременно (пул зеркалирования).
MAX_CONCURRENT_MIRRORS=4

# Фильтры: только ThinPro (без Windows и Smart Zero Core), по умолчанию вкл.
THINPRO_ONLY=true
# Если вдруг нужны и Smart Zero Core: THINPRO_ONLY=false (Windows всё равно
# скроет LINUX_ONLY). Windows можно вернуть: LINUX_ONLY=false.
LINUX_ONLY=true

# Таймзона контейнера.
TZ=UTC

# Порт на хосте (внутри контейнера всегда 8000).
PORT=8080

# Прокси для исходящих запросов к HP, если нужен:
#HTTPS_PROXY=http://proxy:3128
#HTTP_PROXY=http://proxy:3128
#NO_PROXY=localhost,127.0.0.1